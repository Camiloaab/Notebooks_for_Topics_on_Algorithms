   "id": "c04bc5b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "def Collatz(n):\n",
    "    ans = 3*n+1\n",
    "    if n%2==0:\n",
    "        ans= n//2\n",
    "    return ans"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "91d33d71",
   "metadata": {},
   "outputs": [],
   "source": [
    "def Collatz_sec(n):\n",
    "    ans=[n]\n",
    "    while n>1:\n",
    "        n=Collatz(n)\n",
    "        ans.append(n)\n",
    "    return ans"
   ]
  },
